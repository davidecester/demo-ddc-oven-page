// Cloudflare Workers config: serves the Vite build (dist/) as static assets.
// The Worker name must match the project name in the Cloudflare dashboard.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "demo-ddc-oven-page",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
